  "expressions": {
    "SC01": "VALUEWHEN(TIME=1449,IF(SCQ>0,MAX(-100,MIN(100,100*SCC/MAX(SCQ*SQRT(SCQ),0.000000000000000001))),0))"
  },
  "native_header": "SCR:=100*LN(C/REF(C,1));\nSCQ:=SUM(SCR*SCR,29);\nSCC:=SUM(SCR*SCR*SCR,29);\n",
  "definition": "14:20—14:49整数分收盘形成29次r=100*LN(Pt/Pt-1)。Q=sum(r*r), C=sum(r*r*r), SC01=100*C/Q^(3/2)，全平为0；理论界[-100,100]仅作浮点保护。未减平均，不称标准样本偏度。符号反转时SC01反转，净变化和偶次幂集中度相同的走势也可不同。",
  "numerical_boundary": "原生分母MAX(Q*SQRT(Q),1e-18)保护平价分支，全部原有效非平窗口必须Q>=1e-12，证明地板未激活。不得用门槛丢掉原有效样本；同编码逐项核对。",
  "expected_keys": 1258085,
  "expected_valid": 1117397,
  "verification": "复用既有30点价格缓存和原48输入；全部29次变化用独立SQL复建平方、三次幂、比值和整数编码。复读既有固定32个原档窗口960分钟并执行实际REF/SUM/SQRT/VALUEWHEN表达。测试反号、缩放、同净变化同偶次幂、全平、窗口首末变化和窗口外污染。",
  "limitations": "分钟收盘变化的数学代理，不是账户资金流、主动买卖或主力身份，不推断真实跳跃事件。客户端完整价格源、历史股本、指数、状态和实时延迟边界保持。",
  "training": "原2024训练预测2025H1、2024H2—2025H1训练预测2025H2，next_date严格清除边界。原48只加SC01，原known15全池日期基线、日期权重、64轮深度3叶300及q995保持；不叠加此前失败新项。",
  "controls": "三名单全字段比较同参数48、49维常量、旧集中度；相同列表先核准再直接复用统计及已核准相同左侧对照。不同名单只跑一次年度包含两半年，比较同参数48及旧固定48；所有未知、未买入和参考缺口保留。",
  "group_policy": "两模型、全量评分、两段及年度名单共同核准并提交后才读新分组。训练参数、方向和窗口不按2025结果更改。",
  "historical_extension": "只有2025同时改善机会、参考及不利幅度且不依赖稀疏半年的候选，才值得补同输入2023和2024时间顺序扩展；不从已弱结果追加窗口或反向选择。",
