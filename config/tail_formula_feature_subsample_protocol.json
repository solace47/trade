  "native_header": "Q:=VALUEWHEN(TIME=1449,C);\nP20:=VALUEWHEN(TIME=1420,C);\nP35:=VALUEWHEN(TIME=1435,C);\nP01:=VALUEWHEN(TIME=1301,C);\nDD:=DATE<>REF(DATE,1);\nB0:=BARSLAST(DD)+1;\nB1:=B0+REF(BARSLAST(DD)+1,B0);\nB2:=B1+REF(BARSLAST(DD)+1,B1);\nB3:=B2+REF(BARSLAST(DD)+1,B2);\nB4:=B3+REF(BARSLAST(DD)+1,B3);\nB5:=B4+REF(BARSLAST(DD)+1,B4);\nB6:=B5+REF(BARSLAST(DD)+1,B5);\nB7:=B6+REF(BARSLAST(DD)+1,B6);\nB8:=B7+REF(BARSLAST(DD)+1,B7);\nB9:=B8+REF(BARSLAST(DD)+1,B8);\nB10:=B9+REF(BARSLAST(DD)+1,B9);\nB11:=B10+REF(BARSLAST(DD)+1,B10);\nB12:=B11+REF(BARSLAST(DD)+1,B11);\nB13:=B12+REF(BARSLAST(DD)+1,B12);\nB14:=B13+REF(BARSLAST(DD)+1,B13);\nB15:=B14+REF(BARSLAST(DD)+1,B14);\nB16:=B15+REF(BARSLAST(DD)+1,B15);\nB17:=B16+REF(BARSLAST(DD)+1,B16);\nB18:=B17+REF(BARSLAST(DD)+1,B17);\nB19:=B18+REF(BARSLAST(DD)+1,B18);\nB20:=B19+REF(BARSLAST(DD)+1,B19);\nDCP1:=REF(C,B0);\nDCP2:=REF(C,B1);\nDCP3:=REF(C,B2);\nDCP4:=REF(C,B3);\nDCP5:=REF(C,B4);\nDCP6:=REF(C,B5);\nDCP7:=REF(C,B6);\nDCP8:=REF(C,B7);\nDCP9:=REF(C,B8);\nDCP10:=REF(C,B9);\nDCP11:=REF(C,B10);\nDCP12:=REF(C,B11);\nDCP13:=REF(C,B12);\nDCP14:=REF(C,B13);\nDCP15:=REF(C,B14);\nDCP16:=REF(C,B15);\nDCP17:=REF(C,B16);\nDCP18:=REF(C,B17);\nDCP19:=REF(C,B18);\nDCP20:=REF(C,B19);\nDCP21:=REF(C,B20);\nDH:=VALUEWHEN(TIME=1449,HHV(H,B0));\nDL:=VALUEWHEN(TIME=1449,LLV(L,B0));\nDV:=VALUEWHEN(TIME=1449,SUM(V,B0));\nDA:=VALUEWHEN(TIME=1449,SUM(AMOUNT,B0));\nPV5:=REF(SUM(V,B4),B0)/5;\nPH20:=REF(HHV(H,B19),B0);\nPL20:=REF(LLV(L,B19),B0);\nA01:=100*(Q/DYNAINFO(3)-1);\nA02:=100*(DYNAINFO(4)/DYNAINFO(3)-1);\nA03:=100*(Q/DYNAINFO(4)-1);\nA05:=100*(Q/P20-1);\nA06:=100*(Q/P35-1);\nA07:=100*(P20/P01-1);\nA13:=VALUEWHEN(TIME=1449,100*(C/(SUM(AMOUNT,29)/(100*SUM(V,29)))-1));\nA14:=VALUEWHEN(TIME=1449,100*(C/(SUM(AMOUNT,4)/(100*SUM(V,4)))-1));\nA18:=VALUEWHEN(TIME=1449,100*(C/HHV(H,109)-1));\nA19:=VALUEWHEN(TIME=1449,100*(HHV(H,109)-LLV(L,109))/DYNAINFO(3));\nD01:=100*(DCP1/DCP6-1);\nD02:=100*(DCP1/DCP21-1);\nD03:=100*(Q/((DCP1+DCP2+DCP3+DCP4+DCP5)/5