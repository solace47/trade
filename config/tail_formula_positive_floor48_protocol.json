  "native_header": "Q:=VALUEWHEN(TIME=1449,C);\nP20:=VALUEWHEN(TIME=1420,C);\nP35:=VALUEWHEN(TIME=1435,C);\nP01:=VALUEWHEN(TIME=1301,C);\nDD:=DATE<>REF(DATE,1);\nB0:=BARSLAST(DD)+1;\nB1:=B0+REF(BARSLAST(DD)+1,B0);\nB2:=B1+REF(BARSLAST(DD)+1,B1);\nB3:=B2+REF(BARSLAST(DD)+1,B2);\nB4:=B3+REF(BARSLAST(DD)+1,B3);\nB5:=B4+REF(BARSLAST(DD)+1,B4);\nB6:=B5+REF(BARSLAST(DD)+1,B5);\nB7:=B6+REF(BARSLAST(DD)+1,B6);\nB8:=B7+REF(BARSLAST(DD)+1,B7);\nB9:=B8+REF(BARSLAST(DD)+1,B8);\nB10:=B9+REF(BARSLAST(DD)+1,B9);\nB11:=B10+REF(BARSLAST(DD)+1,B10);\nB12:=B11+REF(BARSLAST(DD)+1,B11);\nB13:=B12+REF(BARSLAST(DD)+1,B12);\nB14:=B13+REF(BARSLAST(DD)+1,B13);\nB15:=B14+REF(BARSLAST(DD)+1,B14);\nB16:=B15+REF(BARSLAST(DD)+1,B15);\nB17:=B16+REF(BARSLAST(DD)+1,B16);\nB18:=B17+REF(BARSLAST(DD)+1,B17);\nB19:=B18+REF(BARSLAST(DD)+1,B18);\nB20:=B19+REF(BARSLAST(DD)+1,B19);\nDCP1:=REF(C,B0);\nDCP2:=REF(C,B1);\nDCP3:=REF(C,B2);\nDCP4:=REF(C,B3);\nDCP5:=REF(C,B4);\nDCP6:=REF(C,B5);\nDCP7:=REF(C,B6);\nDCP8:=REF(C,B7);\nDCP9:=REF(C,B8);\nDCP10:=REF(C,B9);\nDCP11:=REF(C,B10);\nDCP12:=REF(C,B11);\nDCP13:=REF(C,B12);\nDCP14:=REF(C,B13);\nDCP15:=REF(C,B14);\nDCP16:=REF(C,B15);\nDCP17:=REF(C,B16);\nDCP18:=REF(C,B17);\nDCP19:=REF(C,B18);\nDCP20:=REF(C,B19);\nDCP21:=REF(C,B20);\nDH:=VALUEWHEN(TIME=1449,HHV(H,B0));\nDL:=VALUEWHEN(TIME=1449,LLV(L,B0));\nDV:=VALUEWHEN(TIME=1449,SUM(V,B0));\nDA:=VALUEWHEN(TIME=1449,SUM(AMOUNT,B0));\nPV5:=REF(SUM(V,B4),B0)/5;\nPH20:=REF(HHV(H,B19),B0);\nPL20:=REF(LLV(L,B19),B0);\nA01:=100*(Q/DYNAINFO(3)-1);\nA02:=100*(DYNAINFO(4)/DYNAINFO(3)-1);\nA03:=100*(Q/DYNAINFO(4)-1);\nA05:=100*(Q/P20-1);\nA06:=100*(Q/P35-1);\nA07:=100*(P20/P01-1);\nA13:=VALUEWHEN(TIME=1449,100*(C/(SUM(AMOUNT,29)/(100*SUM(V,29)))-1));\nA14:=VALUEWHEN(TIME=1449,100*(C/(SUM(AMOUNT,4)/(100*SUM(V,4)))-1));\nA18:=VALUEWHEN(TIME=1449,100*(C/HHV(H,109)-1));\nA19:=VALUEWHEN(TIME=1449,100*(HHV(H,109)-LLV(L,109))/DYNAINFO(3));\nD01:=100*(DCP1/DCP6-1);\nD02:=100*(DCP1/DCP21-1);\nD03:=100*(Q/((DCP1+DCP2+DCP3+DCP4+DCP5)/5)-1);\nD04:=100*(Q/((DCP1+DCP2+DCP3+DCP4+DCP5+DCP6+DCP7+DCP8+DCP9+DCP10+DCP11+DCP12+DCP13+DCP14+DCP15+DCP16+DCP17+DCP18+DCP19+DCP20)/20)-1);\nC02:=100*(DH-DL)/DCP1;\nC03:=100*(DH-Q)/DCP1;\nC04:=100*(MIN(DYNAINFO(4),Q)-DL)/DCP1;\nC07:=100*(Q/PH20-1);\nC08:=100*(Q/PL20-1);\nTR0:=MAX(HHV(H,B0)-LLV(L,B0),MAX(ABS(HHV(H,B0)-REF(C,B0)),ABS(LLV(L,B0)-REF(C,B0))));\nPAT:=(REF(TR0,B0)+REF(TR0,B1)+REF(TR0,B2)+REF(TR0,B3)+REF(TR0,B4)+REF(TR0,B5)+REF(TR0,B6)+REF(TR0,B7)+REF(TR0,B8)+REF(TR0,B9)+REF(TR0,B10)+REF(TR0,B11)+REF(TR0,B12)+REF(TR0,B13)+REF(TR0,B14)+REF(TR0,B15)+REF(TR0,B16)+REF(TR0,B17)+REF(TR0,B18)+REF(TR0,B19))/20;\nVP20:=100*PAT/DCP1;\nICP1:=REF(INDEXC,B0);\nICP2:=REF(INDEXC,B1);\nICP6:=REF(INDEXC,B5);\nICP21:=REF(INDEXC,B20);\nIM20:=(REF(INDEXC,B0)+REF(INDEXC,B1)+REF(INDEXC,B2)+REF(INDEXC,B3)+REF(INDEXC,B4)+REF(INDEXC,B5)+REF(INDEXC,B6)+REF(INDEXC,B7)+REF(INDEXC,B8)+REF(INDEXC,B9)+REF(INDEXC,B10)+REF(INDEXC,B11)+REF(INDEXC,B12)+REF(INDEXC,B13)+REF(INDEXC,B14)+REF(INDEXC,B15)+REF(INDEXC,B16)+REF(INDEXC,B17)+REF(INDEXC,B18)+REF(INDEXC,B19))/20;\nIX1448:=VALUEWHEN(TIME=1448,INDEXC);\nIX1420:=VALUEWHEN(TIME=1420,INDEXC);\nIX1435:=VALUEWHEN(TIME=1435,INDEXC);\nIX1301:=VALUEWHEN(TIME=1301,INDEXC);\nPSH:=REF(FINANCE(7),B0);\n",
